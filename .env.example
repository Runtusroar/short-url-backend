APP_ENV=development
DATABASE_URL=postgresql+psycopg://shorturl:shorturl@db:5432/shorturl
REDIS_URL=redis://redis:6379/0
SECRET_KEY=change-me-to-a-random-secret-key-at-least-32-characters
GEOIP_DB_PATH=/usr/share/GeoIP/GeoLite2-Country.mmdb
GEOIPUPDATE_ACCOUNT_ID=
GEOIPUPDATE_LICENSE_KEY=
APP_TIMEZONE=Asia/Shanghai
# Public scheme used to render complete short-link URLs; production must use https.
PUBLIC_SHORT_URL_SCHEME=http
# Keep false for direct development; production behind Nginx must set true.
COOKIE_SECURE=false
TRUST_PROXY_HEADERS=false
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=
IP_REPUTATION_TTL_HOURS=168
MAXMIND_TIMEOUT_SECONDS=1.5
